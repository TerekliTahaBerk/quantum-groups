    given-names: Taha Berk
    email: terekli@tahaberk.com
    affiliation: "Department of Mathematics, Yıldız Technical University"
    orcid: "https://orcid.org/0009-0004-8266-1116"
repository-code: "https://github.com/TerekliTahaBerk/quantum-groups"
url: "https://github.com/TerekliTahaBerk/quantum-groups"
license: MIT
