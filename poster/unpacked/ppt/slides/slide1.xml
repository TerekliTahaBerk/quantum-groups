<p:txBody><a:bodyPr wrap="square" lIns="180000" tIns="72000" rIns="180000" bIns="72000" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="ctr"><a:lnSpc><a:spcPct val="120000"/></a:lnSpc></a:pPr><a:r><a:rPr lang="tr-TR" sz="3000" b="1" dirty="0"><a:solidFill><a:schemeClr val="accent1"><a:lumMod val="50000"/></a:schemeClr></a:solidFill></a:rPr><a:t>KAYNAKÇA</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="tr-TR" sz="1800" b="1" dirty="0"/><a:t>[1] </a:t></a:r><a:r><a:rPr lang="tr-TR" sz="1800" dirty="0"/><a:t>Çelik, S., Çelik, S. A., (2021). “A New Quantum Supergroup and its Gauss Decomposition”, Reports on Mathematical Physics, 88(2), 259–272.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="tr-TR" sz="1800" b="1" dirty="0"/><a:t>[2] </a:t></a:r><a:r><a:rPr lang="tr-TR" sz="1800" dirty="0"/><a:t>Kassel, C., (1995). Quantum Groups, Springer, New York.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="tr-TR" sz="1800" b="1" dirty="0"/><a:t>[3] </a:t></a:r><a:r><a:rPr lang="tr-TR" sz="1800" dirty="0"/><a:t>Chari, V., Pressley, A., (1994). A Guide to Quantum Groups, Cambridge University Press, Cambridge.</a:t></a:r></a:p></p:txBody></p:sp>
